# Copy to .env and edit. All paths are examples.

# ---- Orchestrator ----
ORCH_HOST=127.0.0.1
ORCH_PORT=8703
WEB_DIR=./web

# ---- Model (OpenAI-compatible endpoint) ----
# Local llama.cpp llama-server is the default. For a remote hosted API, set
# LLM_BASE_URL to it and LLM_API_KEY, and leave LLAMA_SERVER_BIN empty.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_PORT=8080
LLAMA_SERVER_BIN=./tools/llama.cpp/build/bin/llama-server

# ---- Model choice (pick ONE; scripts/pull_model.sh reads MODEL_ID) ----
# Verify the exact GGUF filename on each model's Hugging Face page before pulling.
# The harness routes DETERMINISTICALLY in Python (orchestrator/router.py): the model
# is a bounded transducer that returns a small {"intent","args"} JSON object chosen
# from a closed set, and Python validates and dispatches it. So pick a model that
# reliably emits that clean JSON. Instruct models work; reasoning/"thinking" models
# (e.g. the Qwen3 line) often wrap the JSON in prose or emit reasoning instead, which
# routes worse (the router keyword-falls-back). GGUF Q4_K_M is the recommended quant
# (95-98% quality, runs anywhere).
#
# A) default, verified tool-caller, widest compatibility:
MODEL_ID=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# B) quality on a memory budget (Gemma):
#   MODEL_ID=bartowski/gemma-2-9b-it-GGUF
#   MODEL_FILE=gemma-2-9b-it-Q4_K_M.gguf
# C) more VRAM, want 7B-class speed at higher quality (MoE, ~3-4B active):
#   gpt-oss-20B or Qwen3-Coder-30B GGUF (check the HF page for the file)
# D) Qwen3-8B — CAUTION: a thinking model; may not emit tool calls via the OpenAI
#    endpoint, which breaks tool routing. Prefer an instruct model above.
#   MODEL_ID=Qwen/Qwen3-8B-GGUF
#   MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
MODEL_PATH=./models/${MODEL_FILE}

# ---- Voice (baseline) ----
WHISPER_BIN=./tools/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./tools/whisper.cpp/models/ggml-base.en.bin
PIPER_BIN=./tools/piper/piper
PIPER_VOICE=./tools/piper/voices/en_US-lessac-medium.onnx

# ---- SDA tools ----
GMAT_BIN=./tools/GMAT/bin/GmatConsole
EPHEMERIS_DIR=./data/ephemeris
SATSIM_HOME=./tools/satsim
SCENE_DIR=./data/scenes
